{
  "name": "wonder-egg-world",
  "version": "1.0.0",
  "private": true,
  "description": "Android wrapper for Wonder Egg World (Capacitor + AdMob + Remove-Ads IAP + Firebase Analytics).",
  "scripts": {
    "copy:web": "node copy-web.js",
    "add:android": "npx cap add android",
    "sync": "npm run copy:web && npx cap sync android",
    "patch": "node patch-android.js",
    "assets": "npx capacitor-assets generate --android",
    "prepare:android": "npm run copy:web && npx cap add android && npx cap sync android && npm run patch",
    "build:aab": "cd android && gradlew.bat bundleRelease",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@revenuecat/purchases-capacitor": "^8.0.0",
    "@capacitor-firebase/analytics": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/assets": "^3.0.5"
  }
}
