# SIGNING CONFIG — copy this file to  android/key.properties  (after `npm run prepare:android`)
# and fill in real values. patch-android.js already wired signing.gradle to read it, so once
# this file exists, `npm run build:aab` produces a SIGNED .aab automatically.
#
# storeFile: use a FULL ABSOLUTE path to your keystore (avoids relative-path confusion).
#   Windows example below — use DOUBLE backslashes. Keep the keystore OUTSIDE the android/
#   folder (android/ is regenerated by `cap add`, and is git-ignored anyway).
# NEVER commit the real key.properties or the .keystore. BACK UP THE KEYSTORE — if you lose
#   it you can never update the app on Play.
#
# Create a keystore once (from any terminal, needs the JDK that ships with Android Studio):
#   keytool -genkey -v -keystore C:\Users\you\keys\wonder-egg-upload.keystore \
#           -alias upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=C:\\Users\\you\\keys\\wonder-egg-upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
